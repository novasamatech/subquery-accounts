{
  "name": "subquery-proxy",
  "version": "1.0.0",
  "description": "This project can be used as a starting point for developing your SubQuery project",
  "main": "dist/index.js",
  "scripts": {
    "build": "subql build",
    "codegen": "subql codegen",
    "start:docker": "cross-env PROJECT_PATH=$PROJECT_PATH docker-compose pull && docker-compose up --remove-orphans",
    "dev": "subql codegen && subql build && docker-compose pull && docker-compose up --remove-orphans",
    "prepack": "rm -rf dist && npm run build",
    "test": "subql build && subql-node test",
    "deploy:polkadot": "subql publish -f polkadot.yaml",
    "deploy:kusama": "subql publish -f kusama.yaml",
    "deploy:moonbeam": "subql publish -f moonbeam.yaml",
    "deploy:moonriver": "subql publish -f moonriver.yaml",
    "deploy:rococo": "subql publish -f rococo.yaml",
    "deploy:westend": "subql publish -f westend.yaml",
    "deploy:hydradx": "subql publish -f hydradx.yaml"
  },
  "homepage": "https://github.com/subquery/subql-starter",
  "repository": "github:subquery/subql-starter",
  "files": [
    "dist",
    "schema.graphql",
    "project.yaml"
  ],
  "author": "Novasama Technlogies",
  "license": "MIT",
  "packageManager": "yarn@4.12.0",
  "devDependencies": {
    "@polkadot/api": "^16",
    "@subql/cli": "latest",
    "@subql/testing": "latest",
    "@subql/types": "latest",
    "cross-env": "7.0.3",
    "moonbeam-types-bundle": "2.0.10",
    "prettier": "3.6.2",
    "typescript": "5.8.3"
  },
  "resolutions": {
    "ipfs-unixfs": "6.0.6",
    "@polkadot/api": "16.5.4",
    "@polkadot/api-augment": "16.5.4",
    "@polkadot/api-base": "16.5.4",
    "@polkadot/api-derive": "16.5.4",
    "@polkadot/keyring": "14.0.1",
    "@polkadot/rpc-augment": "16.5.4",
    "@polkadot/rpc-core": "16.5.4",
    "@polkadot/rpc-provider": "16.5.4",
    "@polkadot/types": "16.5.4",
    "@polkadot/types-augment": "16.5.4",
    "@polkadot/types-codec": "16.5.4",
    "@polkadot/types-create": "16.5.4",
    "@polkadot/types-known": "16.5.4"
  },
  "dependencies": {
    "@polkadot/api-augment": "^16",
    "@polkadot/types": "^16",
    "@polkadot/util": "14.0.1",
    "@polkadot/util-crypto": "14.0.1",
    "@subql/types-core": "latest",
    "subquery-call-visitor": "1.4.4",
    "tslib": "2.8.1"
  },
  "exports": {
    "moonbeamChaintypes": "./chainTypes/moonbeamChaintypes.ts",
    "bittensorChaintypes": "./chainTypes/bittensorChainTypes.ts",
    "alephZeroChaintypes": "./chainTypes/alephZeroChaintypes.ts",
    "kusamaAssetHubChaintypes": "./chainTypes/kusamaAssetHubChaintypes.ts",
    "polkadotAssetHubChaintypes": "./chainTypes/polkadotAssetHubChaintypes.ts",
    "westendAssetHubChaintypes": "./chainTypes/westendAssetHubChaintypes.ts",
    "availChainTypes": "./chainTypes/availChainTypes.ts"
  }
}
